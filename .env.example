# Copy this file to .env (never commit .env) to point the backend at other services.
# docker compose reads .env automatically; anything left unset uses the local containers.

# PostgreSQL (JDBC URL). Managed databases usually need SSL. Flyway creates the tables on
# first start, so the user needs permission to create tables in that database.
# DATABASE_URL=jdbc:postgresql://my-db.example.com:5432/rostersync?sslmode=require
# DATABASE_USER=rostersync
# DATABASE_PASSWORD=change-me

# Redis (cache and event stream). Use rediss:// for TLS.
# REDIS_URL=rediss://default:change-me@my-redis.example.com:6379/0

# Other settings
# JWT_SECRET=at-least-32-characters-long-random-secret
# SAFETY_BRAKE_THRESHOLD=0.30
